                                         "jsCode":  "// Build the final success payload. An empty model answer is treated as a generation failure.\nconst out = $input.first().json || {};\nconst answer = typeof out.text === \u0027string\u0027 ? out.text.trim() : \u0027\u0027;\nif (answer === \u0027\u0027) {\n  throw new Error(\u0027Model returned an empty answer\u0027);\n}\n\nconst ctx = $(\u0027Build Context\u0027).first().json;\nreturn [{ json: { status: \u0027ok\u0027, answer, sources: ctx.sources } }];\n"
