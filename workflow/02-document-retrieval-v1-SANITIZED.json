                  {
                      "parameters":  {
                                         "jsCode":  "\nconst MAX_QUESTION_CHARS = 2000;\n\nconst input = $input.first().json || {};\nconst body =\n  input.body \u0026\u0026 typeof input.body === \u0027object\u0027\n    ? input.body\n    : input;\n\nconst raw = body.question;\n\nlet error = null;\n\nif (typeof raw !== \u0027string\u0027) {\n  error = \"Field \u0027question\u0027 is required and must be a string.\";\n} else if (raw.trim().length === 0) {\n  error = \"Field \u0027question\u0027 must not be empty.\";\n} else if (raw.trim().length \u003e MAX_QUESTION_CHARS) {\n  error = `Field \u0027question\u0027 must be at most ${MAX_QUESTION_CHARS} characters.`;\n}\n\nif (error) {\n  return [{ json: { valid: false, error } }];\n}\n\nreturn [{ json: { valid: true, question: raw.trim() } }];\n"
                                     },
