                  {
                      "parameters":  {
                                         "jsCode":  "const MAX_BYTES = 5 * 1024 * 1024;\n\nconst item = $input.first();\nconst bin = item.binary ?? {};\nconst key = Object.keys(bin)[0];\n\nif (!key) {\n  return [{\n    json: {\n      ok: false,\n      code: 400,\n      message: \u0027No file uploaded. Send a .docx file in the form field.\u0027\n    }\n  }];\n}\n\nconst f = bin[key];\nconst name = (f.fileName ?? \u0027\u0027).toLowerCase();\n\n// Read actual binary size, including filesystem-stored files\nconst fileBuffer = await this.helpers.getBinaryDataBuffer(0, key);\nconst bytes = fileBuffer.length;\n\nif (!name.endsWith(\u0027.docx\u0027)) {\n  return [{\n    json: {\n      ok: false,\n      code: 415,\n      message: \u0027Only .docx files are accepted.\u0027\n    },\n    binary: bin\n  }];\n}\n\nif (bytes \u003e MAX_BYTES) {\n  return [{\n    json: {\n      ok: false,\n      code: 413,\n      message: \u0027File too large. Maximum size is 5 MB.\u0027\n    },\n    binary: bin\n  }];\n}\n\nreturn [{\n  json: {\n    ok: true\n  },\n  binary: bin\n}];"
                                     },
