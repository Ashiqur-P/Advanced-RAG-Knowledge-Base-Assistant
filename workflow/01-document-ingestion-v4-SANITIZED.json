                  {
                      "parameters":  {
                                         "jsCode":  "const items = $input.all();\n\nconst docId =\n  $(\u0027Enrich Metadata\u0027).first().json.documentId\n  ?? $(\u0027Compute Document Hash\u0027).first().json.documentHash\n  ?? \u0027unknown\u0027;\n\nreturn [\n  {\n    json: {\n      status: \u0027success\u0027,\n      documentId: docId,\n      chunks: items.length\n    }\n  }\n];"
