                  {
                      "parameters":  {
                                         "jsCode":  "const items = $input.all();\n\nfor (const item of items) {\n  if (!item.binary?.file) {\n    throw new Error(\"Binary field \u0027file\u0027 not found.\");\n  }\n\n  item.binary.data0 = item.binary.file;\n}\n\nreturn items;"
